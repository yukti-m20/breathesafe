# URL of the ESP32-C3 badge (mDNS or IP address)
ESP32_URL=http://badge.local

# How often (in seconds) to poll the badge for sensor data
POLL_INTERVAL_S=10

# OpenSearch connection settings
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin

# Strands AI model provider: bedrock | anthropic | openai | ollama
STRANDS_PROVIDER=bedrock
STRANDS_MODEL_ID=us.amazon.nova-lite-v1:0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# How often (in seconds) to regenerate AI health actions even if level is unchanged
AI_REGEN_INTERVAL_S=300
